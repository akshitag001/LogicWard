# LogicWard configuration — copy to .env and edit. Every value is also settable
# as a real environment variable. .env is gitignored; never commit real secrets.

# ── Mode ──────────────────────────────────────────────────────────────────────
# 1 = demo (single machine, ephemeral session key, demo logins). 0 = production:
# the app REFUSES to start unless the three secrets below are strong + non-default.
LOGICWARD_DEMO_MODE=1

# ── Secrets (REQUIRED when LOGICWARD_DEMO_MODE=0) ─────────────────────────────
# Flask session-cookie signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
LOGICWARD_SECRET=
# Shared token the Pi edge agent presents on POST /api/ingest and /api/telemetry.
LOGICWARD_TOKEN=
# HMAC-SHA256 key that signs the approved baseline manifest.
LOGICWARD_HMAC_KEY=
# Ed25519 private key (PEM) used to sign the PDF forensic report (optional; a demo
# keypair is generated under logicward/data/keys/ when unset).
LOGICWARD_REPORT_KEY=

# ── Plant / deployment topology ───────────────────────────────────────────────
LOGICWARD_EMBED_PLANT=1              # 1 = in-process PLC on this host; 0 = real/remote Pi
LOGICWARD_BASELINE_SOURCE=file       # file = shipped reviewed L5X; live = capture current program
LOGICWARD_PI_HOST=127.0.0.1          # PLC host when EMBED_PLANT=0
LOGICWARD_MODBUS_PORT=5020
LOGICWARD_PROGRAM_PORT=8081
LOGICWARD_WRITES_PORT=5024
LOGICWARD_INGEST_HOST=127.0.0.1      # set to 0.0.0.0 only for the split Pi/laptop mode
LOGICWARD_INGEST_PORT=8080
LOGICWARD_INGEST_URL=
LOGICWARD_TELEMETRY_URL=

# ── Engine timing (seconds) ───────────────────────────────────────────────────
LOGICWARD_POLL_INTERVAL=1.0
LOGICWARD_AGENT_FLUSH_INTERVAL=1.0

# ── Site B: GRFICS chemical reactor (optional) ────────────────────────────────
LOGICWARD_MULTISITE=1
LOGICWARD_GRFICS_BUILD_DIR=
LOGICWARD_GRFICS_MODBUS_HOST=127.0.0.1
LOGICWARD_GRFICS_MODBUS_PORT=5021
LOGICWARD_GRFICS_DASH_PORT=8095

# ── Red-team console attack target allow-list (Prompt 2.5) ────────────────────
LOGICWARD_ATTACK_TARGETS=            # comma-separated extra hosts the console may target

# ── Storage ───────────────────────────────────────────────────────────────────
LOGICWARD_DATA_DIR=
LOGICWARD_EVIDENCE_PATH=
LOGICWARD_BASELINE_MANIFEST=
LOGICWARD_EVENT_HISTORY_MAX=5000
