<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="34.00" TargetName="ThermalPlant_Safety" TargetType="Controller" ContainsContext="false" ExportDate="Tue Jul 21 09:14:03 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
 <Controller Use="Target" Name="ThermalPlant_Safety" ProcessorType="1756-L83E" MajorRev="34" MinorRev="11" TimeSlice="20" ShareUnusedTimeSlice="1" ProjectCreationDate="Mon Jan 06 08:00:00 2025" LastModifiedDate="Tue Jul 21 09:12:55 2026" SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" SFCLastScan="DontScan" ProjectSN="16#0000_a1b2" MatchProjectToController="false" CanUseRPIFromProducer="false" InhibitAutomaticFirmwareUpdate="0">
  <RedundancyInfo Enabled="false"/>
  <Security Code="0" ChangesToDetect="16#ffff_ffff_ffff_ffff"/>
  <DataTypes/>
  <Tags>
   <Tag Name="Drum_Level_LL_SP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
    <Description><![CDATA[Boiler drum level low-low trip setpoint (mm)]]></Description>
    <Data Format="Decorated">
     <DataValue DataType="REAL" Radix="Float" Value="220.0"/>
    </Data>
   </Tag>
   <Tag Name="Steam_Press_HH_SP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
    <Description><![CDATA[Main steam pressure high-high trip setpoint (bar)]]></Description>
    <Data Format="Decorated">
     <DataValue DataType="REAL" Radix="Float" Value="175.0"/>
    </Data>
   </Tag>
   <Tag Name="Turbine_Overspeed_SP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
    <Description><![CDATA[Turbine overspeed trip setpoint (rpm)]]></Description>
    <Data Format="Decorated">
     <DataValue DataType="REAL" Radix="Float" Value="3300.0"/>
    </Data>
   </Tag>
   <Tag Name="Condenser_Vac_LO_SP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
    <Description><![CDATA[Condenser vacuum low trip setpoint (mbar abs)]]></Description>
    <Data Format="Decorated">
     <DataValue DataType="REAL" Radix="Float" Value="85.0"/>
    </Data>
   </Tag>
   <Tag Name="Bearing_Vib_HI_SP" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read Only">
    <Description><![CDATA[Turbine bearing vibration high alarm setpoint (mm/s)]]></Description>
    <Data Format="Decorated">
     <DataValue DataType="REAL" Radix="Float" Value="11.2"/>
    </Data>
   </Tag>
   <Tag Name="Plant_Running" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Unit is in run state]]></Description>
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="1"/></Data>
   </Tag>
   <Tag Name="Flame_Detected" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Furnace flame scanner healthy]]></Description>
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="1"/></Data>
   </Tag>
   <Tag Name="Drum_Level" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Boiler drum level (mm) - from IR03]]></Description>
    <Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
   </Tag>
   <Tag Name="Steam_Pressure" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Main steam pressure (bar) - from IR01]]></Description>
    <Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
   </Tag>
   <Tag Name="Turbine_Speed" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Turbine shaft speed (rpm) - from IR04]]></Description>
    <Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
   </Tag>
   <Tag Name="Condenser_Vacuum" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Condenser vacuum (mbar abs) - from IR05]]></Description>
    <Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
   </Tag>
   <Tag Name="Bearing_Vibration" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
    <Description><![CDATA[Turbine bearing vibration (mm/s) - from IR06]]></Description>
    <Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></Data>
   </Tag>
   <Tag Name="Feedwater_Trip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
   <Tag Name="Main_Steam_Trip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
   <Tag Name="Turbine_Trip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
   <Tag Name="Fuel_Trip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
   <Tag Name="Condenser_Trip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
   <Tag Name="Vibration_Alarm" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
    <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
   </Tag>
  </Tags>
  <Programs>
   <Program Name="MainProgram" TestEdits="false" MainRoutineName="SafetyInterlocks" Disabled="false" UseAsFolder="false">
    <Tags/>
    <Routines>
     <Routine Name="SafetyInterlocks" Type="RLL">
      <RLLContent>
       <Rung Number="0" Type="N" EditedDate="Tue Jul 21 09:11:02 2026">
        <Comment><![CDATA[SIL-2  Boiler drum level low-low -> trip feedwater (loss of drum level protection)]]></Comment>
        <Text><![CDATA[XIC(Plant_Running)[LES(Drum_Level,Drum_Level_LL_SP)]OTE(Feedwater_Trip);]]></Text>
       </Rung>
       <Rung Number="1" Type="N" EditedDate="Tue Jul 21 09:11:14 2026">
        <Comment><![CDATA[SIL-2  Main steam pressure high-high -> main steam trip (overpressure protection)]]></Comment>
        <Text><![CDATA[XIC(Plant_Running)[GRT(Steam_Pressure,Steam_Press_HH_SP)]OTE(Main_Steam_Trip);]]></Text>
       </Rung>
       <Rung Number="2" Type="N" EditedDate="Tue Jul 21 09:11:29 2026">
        <Comment><![CDATA[SIL-3  Turbine overspeed -> turbine trip (mechanical destruction protection)]]></Comment>
        <Text><![CDATA[[GRT(Turbine_Speed,Turbine_Overspeed_SP)]OTE(Turbine_Trip);]]></Text>
       </Rung>
       <Rung Number="3" Type="N" EditedDate="Tue Jul 21 09:11:41 2026">
        <Comment><![CDATA[SIL-2  Furnace loss of flame -> fuel trip (furnace explosion protection)]]></Comment>
        <Text><![CDATA[XIC(Plant_Running)XIO(Flame_Detected)OTE(Fuel_Trip);]]></Text>
       </Rung>
       <Rung Number="4" Type="N" EditedDate="Tue Jul 21 09:11:55 2026">
        <Comment><![CDATA[SIL-1  Condenser vacuum low -> condenser trip (turbine exhaust protection)]]></Comment>
        <Text><![CDATA[XIC(Plant_Running)[LES(Condenser_Vacuum,Condenser_Vac_LO_SP)]OTE(Condenser_Trip);]]></Text>
       </Rung>
       <Rung Number="5" Type="N" EditedDate="Tue Jul 21 09:12:08 2026">
        <Comment><![CDATA[Turbine bearing vibration high -> operator alarm (advisory, not a trip)]]></Comment>
        <Text><![CDATA[[GRT(Bearing_Vibration,Bearing_Vib_HI_SP)]OTE(Vibration_Alarm);]]></Text>
       </Rung>
      </RLLContent>
     </Routine>
    </Routines>
   </Program>
  </Programs>
  <Tasks>
   <Task Name="SafetyTask" Type="PERIODIC" Rate="50" Priority="10" Watchdog="200" DisableUpdateOutputs="false" InhibitTask="false">
    <ScheduledPrograms>
     <ScheduledProgram Name="MainProgram"/>
    </ScheduledPrograms>
   </Task>
  </Tasks>
 </Controller>
</RSLogix5000Content>
